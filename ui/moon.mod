name = "laplaceliu/tycho_ui"

version = "0.8.0"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/tycho-mbt/tycho"

preferred_target = "native"

description = "Tycho UI — Flutter-inspired pure-MoonBit declarative UI framework (three trees, Signals, single-pass BoxConstraints, GestureArena, virtualized ListView) over tycho_2d & tycho"

keywords = [ "ui", "gui", "flutter", "widgets", "tycho" ]

import {
  "laplaceliu/tycho@0.8.0",
  "laplaceliu/tycho_2d@0.8.0",
}
