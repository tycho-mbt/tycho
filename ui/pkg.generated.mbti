pub fn UiTree::hit_test(Self, @tycho_2d.Point) -> Array[HitTestEntry]
pub fn UiTree::layout_root(Self, Float, Float) -> Unit
pub fn UiTree::mark_dirty(Self, Int32) -> Unit
pub fn UiTree::mount_root(Self, Widget) -> Unit
pub fn UiTree::new(theme? : ThemeData) -> Self
pub fn UiTree::render_count(Self) -> Int32
pub fn UiTree::render_root(Self) -> RenderNode?
pub fn UiTree::sync_list_viewports(Self) -> Bool

pub struct Widget {
  key : Key?
  kind : WidgetKind
}

pub(all) enum WidgetKind {
  Builder(Int32, (BuildContext) -> Widget)
  ThemeProvider(ThemeData, Widget)
  SizedBox(Float?, Float?, Widget?)
  Padding(EdgeInsets, Widget)
  Align(Alignment, Widget)
  ConstrainedBox(BoxConstraints, Widget)
  DecoratedBox(DecoratedProps, Widget?)
  Flex(Axis, MainAxisAlignment, CrossAxisAlignment, MainAxisSize, Float, Array[Widget])
  Expanded(Int32, FlexFit, Widget)
  Stack(Alignment, Array[Widget])
  Positioned(Float?, Float?, Float?, Float?, Float?, Float?, Widget)
  Wrap(Float, Float, Array[Widget])
  ClipRect(Widget)
  ClipRRect(Float, Widget)
  Opacity(Float, Widget)
  Transform(@tycho_2d.Matrix3, Widget)
  BackdropFilter(Float, Float, @tycho_2d.Color, Widget)
  RepaintBoundary(Widget)
  TextNode(String, @tycho_2d.TextStyle, @tycho_2d.TextAlign, Int32, String)
  ImageNode(@tycho_2d.Image2D, Float, Float)
  CustomPaint(@tycho_2d.Size, (@tycho_2d.Canvas, @tycho_2d.Size) -> Unit)
  GestureNode(GestureCallbacks, Widget)
  ListViewBuilder(Int32, Float, ScrollController, (BuildContext, Int32) -> Widget)
  ScrollViewportNode(ScrollController, Axis, Widget)
  TextFieldNode(TextController, String, Float, Float)
}

pub struct WidgetTester {
  tree : UiTree
  arena : GestureArena
  width : Float
  height : Float
}
pub fn WidgetTester::element_count(Self) -> Int32
pub fn WidgetTester::move_mouse(Self, Float, Float) -> Unit
pub fn WidgetTester::new(Widget, width? : Float, height? : Float, theme? : ThemeData) -> Self
pub fn WidgetTester::pump_frame(Self) -> @tycho_2d.DisplayList
pub fn WidgetTester::render_to_texture(Self, @tycho_2d.Renderer2D, @tycho.Texture, clear_color? : @tycho_2d.Color) -> Unit raise @tycho.RhiError
pub fn WidgetTester::scroll(Self, Float, Float, Float, Float) -> Unit
pub fn WidgetTester::send_key(Self, Int32, shift? : Bool, ctrl? : Bool) -> Unit
pub fn WidgetTester::send_text(Self, String) -> Unit
pub fn WidgetTester::tap(Self, Float, Float) -> Unit

