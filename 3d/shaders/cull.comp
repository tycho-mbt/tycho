#version 450
// Per-instance frustum culling for opaque instanced batches. Writes a
// compacted instance list and atomically grows the batch's indirect draw.
layout(local_size_x = 64) in;

struct ObjectGpu {
    mat4 model;
    mat4 normalMat;
    float c0;
    float c1;
    float c2;
    float radius;
};
layout(std430, binding = 0) readonly buffer Obj { ObjectGpu objects[]; };
layout(std430, binding = 1) writeonly buffer Vis { uint visible[]; };

struct DrawIndexedCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, binding = 2) buffer Cmd { DrawIndexedCmd cmds[]; };

layout(push_constant) uniform PC {
    vec4 planes[6];
    vec4 params; // first, count, listOffset, cmdIndex (numeric floats)
} pc;

void main() {
    uint first = uint(pc.params.x + 0.5);
    uint count = uint(pc.params.y + 0.5);
    uint list_offset = uint(pc.params.z + 0.5);
    uint cmd_index = uint(pc.params.w + 0.5);
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) {
        return;
    }
    ObjectGpu o = objects[first + i];
    vec3 c = (o.model * vec4(o.c0, o.c1, o.c2, 1.0)).xyz;
    float scale = max(max(length(o.model[0].xyz), length(o.model[1].xyz)),
                      length(o.model[2].xyz));
    float r = o.radius * scale;
    for (int p = 0; p < 6; ++p) {
        vec4 pl = pc.planes[p];
        if (dot(pl.xyz, c) + pl.w < -r) {
            return;
        }
    }
    uint slot = atomicAdd(cmds[cmd_index].instanceCount, 1u);
    visible[list_offset + slot] = i;
}
