#version 450
struct DrawCmd {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};
struct DrawIndexedCmd {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer IndirectOut { DrawCmd cmds[2]; } out_buf;
layout(std430, binding = 1) buffer IndexedOut { DrawIndexedCmd cmds[2]; } idx_buf;
void main() {
    out_buf.cmds[0] = DrawCmd(3, 1, 0, 0);
    out_buf.cmds[1] = DrawCmd(3, 1, 3, 0);
    idx_buf.cmds[0] = DrawIndexedCmd(3, 1, 0, 0, 0);
    idx_buf.cmds[1] = DrawIndexedCmd(3, 1, 3, 0, 0);
}
