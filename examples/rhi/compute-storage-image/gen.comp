#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(binding = 0, rgba8) uniform writeonly image2D outImg;
layout(push_constant) uniform Push {
    vec4 params;
} pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    int w = int(pc.params.x);
    int h = int(pc.params.y);
    if (p.x >= w || p.y >= h) return;
    float u = float(p.x) / max(1.0, pc.params.x - 1.0);
    float v = float(p.y) / max(1.0, pc.params.y - 1.0);
    imageStore(outImg, p, vec4(u, v, pc.params.z, pc.params.w));
}
