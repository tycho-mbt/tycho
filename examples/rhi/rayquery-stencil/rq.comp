#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D outImg;

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(outImg);
    if (gid.x >= sz.x || gid.y >= sz.y) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(sz) * 2.0 - 1.0;
    vec3 origin = vec3(uv.x, -uv.y, -2.0);
    vec3 dir = vec3(0.0, 0.0, 1.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.01, dir, 10.0);
    while (rayQueryProceedEXT(rq)) {}

    vec4 col = vec4(0.08, 0.12, 0.25, 1.0);
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        col = vec4(1.0 - bary.x - bary.y, bary.x, bary.y, 1.0);
    }
    imageStore(outImg, gid, col);
}
