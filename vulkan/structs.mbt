pub fn create_debug_messenger(inst : VkInstance, ifn : InstanceFn, severity : UInt32, types : UInt32, cb : FuncRef[(UInt32, UInt32, VkDebugUtilsMessengerCallbackDataEXT, UInt64) -> UInt32]) -> VkDebugUtilsMessengerEXT { let ci = VkDebugUtilsMessengerCreateInfoEXT::new(); ci.set_messageSeverity(severity); ci.set_messageType(types); ci.set_pfnUserCallback(cb); ci.set_pUserData((0 : UInt64)); let out = FixedArray::make(1, VkDebugUtilsMessengerEXT::null()); let _ = (ifn.vkCreateDebugUtilsMessengerEXT)(inst, ci, VkAllocationCallbacks::null(), out); ci.free(); out[0] }
pub fn destroy_debug_messenger(inst : VkInstance, ifn : InstanceFn, m : VkDebugUtilsMessengerEXT) -> Unit { (ifn.vkDestroyDebugUtilsMessengerEXT)(inst, m, VkAllocationCallbacks::null()) }

