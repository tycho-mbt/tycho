// Generated struct constructors + field accessors (C handles layout).
// pNext chains: head.set_pNext(next.as_ptr()). Both structs must stay
// alive (not .free()d) until the Vulkan call that consumes head returns.

extern "c" fn cstr_ffi(bytes : Bytes, len : Int32) -> UInt64 = "tycho_cstr"
pub fn cstr(s : String) -> UInt64 { let b = @utf8.encode(s); cstr_ffi(b, b.length()) }
pub fn cstr_array(strs : FixedArray[String]) -> FixedArray[UInt64] { let ptrs = FixedArray::make(strs.length(), (0 : UInt64)); for i = 0; i < strs.length(); i = i + 1 { ptrs[i] = cstr(strs[i]) }; ptrs }

extern "c" fn read_cstr_ffi(p : UInt64) -> String = "tycho_read_cstr"
pub fn read_cstr(p : UInt64) -> String { read_cstr_ffi(p) }
extern "c" fn bytes_ptr_ffi(a : Bytes) -> UInt64 = "tycho_as_ptr"
pub fn bytes_ptr(a : Bytes) -> UInt64 { bytes_ptr_ffi(a) }
extern "c" fn aligned_alloc_ffi(size : Int32, alignment : Int32) -> UInt64 = "tycho_aligned_alloc"
pub fn aligned_alloc(size : Int32, alignment : Int32) -> UInt64 { aligned_alloc_ffi(size, alignment) }
extern "c" fn free_ptr_ffi(p : UInt64) = "tycho_free_ptr"
pub fn free_ptr(p : UInt64) -> Unit { free_ptr_ffi(p) }
extern "c" fn memcpy_ptr_ffi(dst : UInt64, src : UInt64, bytes : Int32) = "tycho_memcpy_ptr"
pub fn memcpy_ptr(dst : UInt64, src : UInt64, bytes : Int32) -> Unit { memcpy_ptr_ffi(dst, src, bytes) }
