#borrow(transform)
extern "c" fn rt_instance_set_ffi(p : UInt64, i : Int32, transform : VkTransformMatrixKHR, customIndex : UInt32, mask : UInt32, sbtOffset : UInt32, flags : UInt32, addr : UInt64) = "tycho_rt_instance_set"
extern "c" fn rt_instance_free_ffi(p : UInt64) = "tycho_rt_instance_free"
pub fn rt_instance_array(n : Int32) -> UInt64 { rt_instance_array_ffi(n) }
pub fn rt_instance_set(p : UInt64, i : Int32, transform : VkTransformMatrixKHR, customIndex : UInt32, mask : UInt32, sbtOffset : UInt32, flags : UInt32, addr : UInt64) -> Unit { rt_instance_set_ffi(p, i, transform, customIndex, mask, sbtOffset, flags, addr) }
pub fn rt_instance_free(p : UInt64) -> Unit { rt_instance_free_ffi(p) }

